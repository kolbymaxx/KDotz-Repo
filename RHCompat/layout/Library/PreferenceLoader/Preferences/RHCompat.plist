<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>entry</key>
	<dict>
		<key>cell</key>
		<string>PSLinkCell</string>
		<key>icon</key>
		<string></string>
		<key>label</key>
		<string>RHCompat</string>
	</dict>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>RHCompat</string>
			<key>footerText</key>
			<string>RootHide companion. Early-load path shim rewrites /var/jb and classic PreferenceLoader/data paths into the live jbroot so unpatched rootless tweaks keep working. Narrow by design — not a full filesystem virtualization layer.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.kolby.rhcompat</string>
			<key>key</key>
			<string>enabled</string>
			<key>label</key>
			<string>Enable path shim</string>
			<key>PostNotification</key>
			<string>com.kolby.rhcompat/ReloadPrefs</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>Rewrites: /var/jb, /Library/PreferenceLoader, /Library/PreferenceBundles, and non-Apple plists under /var/mobile/Library/Preferences when the jbroot copy should win. Respring after changing the toggle.</string>
		</dict>
	</array>
	<key>title</key>
	<string>RHCompat</string>
</dict>
</plist>
